# Hardware config and volumes for Gazebo (Default: WSL2)
#
# Instructions for native Linux users (Ubuntu/Debian):
# 1. Keep X11_SOCKET_MOUNT as it is.
# 2. Leave WSLG_MOUNT and DXG_DEVICE empty (e.g. WSLG_MOUNT= )

# X11 Socket (Common for both native Linux and WSL2)
X11_SOCKET_MOUNT=/tmp/.X11-unix:/tmp/.X11-unix:rw

# Mount for WSLg (Only for WSL2 on Windows, leave empty on native Linux)
WSLG_MOUNT=

# Graphic device (/dev/dri for native Linux, /dev/dxg for WSL2)
GPU_DEVICE=/dev/dri


