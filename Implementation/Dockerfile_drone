FROM ros:jazzy-ros-base

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies for development, git, and Rust compilation
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    pkg-config \
    libssl-dev \
    git \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install Rust toolchain globally via rustup
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable

# Set up ROS2 environment sourcing in bashrc for interactive shells
RUN echo "source /opt/ros/jazzy/setup.bash" >> /etc/bash.bashrc

# Set up workspace directory
WORKDIR /usr/src/app

# Copy the entrypoint script and make it executable
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Use entrypoint.sh to automatically source ROS2 and configure the unique namespace
ENTRYPOINT ["/entrypoint.sh"]

CMD ["bash"]
