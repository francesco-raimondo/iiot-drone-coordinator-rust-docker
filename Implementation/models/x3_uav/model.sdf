<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="x3">
    <pose>0 0 0.2 0 0 0</pose>
    <static>false</static>
    
    <link name="base_link">
      <inertial>
        <mass>1.5</mass>
        <inertia>
