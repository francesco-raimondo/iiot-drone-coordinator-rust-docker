<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="x3">
    <pose>0 0 0.2 0 0 0</pose>
    <static>false</static>
    
    <link name="base_link">
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.08</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.08</iyy>
          <iyz>0</iyz>
          <izz>0.12</izz>
        </inertia>
      </inertial>

      <!-- COLLISION (Simple box for collision efficiency) -->
      <collision name="base_link_collision">
        <geometry>
          <box>
            <size>0.5 0.5 0.15</size>
          </box>
        </geometry>
      </collision>

      <!-- VISUAL 1: Central Body (Dark Metallic Gray Sphere/Cylinder) -->
      <visual name="central_body_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.25 1</ambient>
          <diffuse>0.2 0.2 0.25 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>
      </visual>

      <!-- VISUAL 2: Front Left Arm -->
      <visual name="arm_fl_visual">
        <pose>0.12 0.12 0 0 0 0.7854</pose>
        <geometry>
          <box>
            <size>0.25 0.025 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.1 0.1 1</ambient> <!-- Red for front -->
          <diffuse>0.8 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <!-- VISUAL 3: Front Right Arm -->
      <visual name="arm_fr_visual">
        <pose>0.12 -0.12 0 0 0 -0.7854</pose>
        <geometry>
          <box>
            <size>0.25 0.025 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.1 0.1 1</ambient> <!-- Red for front -->
          <diffuse>0.8 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <!-- VISUAL 4: Back Left Arm -->
      <visual name="arm_bl_visual">
        <pose>-0.12 0.12 0 0 0 -0.7854</pose>
        <geometry>
          <box>
            <size>0.25 0.025 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient> <!-- Black for back -->
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <!-- VISUAL 5: Back Right Arm -->
      <visual name="arm_br_visual">
        <pose>-0.12 -0.12 0 0 0 0.7854</pose>
        <geometry>
          <box>
            <size>0.25 0.025 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient> <!-- Black for back -->
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <!-- VISUAL 10: Landing Leg FL -->
      <visual name="leg_fl_visual">
        <pose>0.2 0.2 -0.05 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>

      <!-- VISUAL 11: Landing Leg FR -->
      <visual name="leg_fr_visual">
        <pose>0.2 -0.2 -0.05 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>

      <!-- VISUAL 12: Landing Leg BL -->
      <visual name="leg_bl_visual">
        <pose>-0.2 0.2 -0.05 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>

      <!-- VISUAL 13: Landing Leg BR -->
      <visual name="leg_br_visual">
        <pose>-0.2 -0.2 -0.05 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>

    </link>

    <!-- ======================================================= -->
    <!-- ROTOR LINKS (real physical bodies, one per propeller)    -->
    <!-- Layout (X pattern, matches the arm visuals on base_link):-->
    <!--   rotor_0 = Front-Left  (ccw)   rotor_1 = Front-Right (cw)-->
    <!--   rotor_2 = Back-Left   (cw)    rotor_3 = Back-Right  (ccw)-->
    <!-- Diagonal pairs spin the same direction so yaw torque    -->
    <!-- cancels out in hover, as required for a quadrotor.      -->
    <!-- ======================================================= -->

    <link name="rotor_0">
      <pose>0.2 0.2 0.02 0 0 0</pose>
      <inertial>
        <mass>0.009</mass>
        <inertia>
          <ixx>1.75e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.75e-05</iyy>
          <iyz>0</iyz>
          <izz>3.5e-05</izz>
        </inertia>
      </inertial>
      <collision name="rotor_0_collision">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="rotor_0_visual">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.0 0.7 0.9 0.7</ambient>
          <diffuse>0.0 0.7 0.9 0.7</diffuse>
        </material>
      </visual>
    </link>

    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <link name="rotor_1">
      <pose>0.2 -0.2 0.02 0 0 0</pose>
      <inertial>
        <mass>0.009</mass>
        <inertia>
          <ixx>1.75e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.75e-05</iyy>
          <iyz>0</iyz>
          <izz>3.5e-05</izz>
        </inertia>
      </inertial>
      <collision name="rotor_1_collision">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="rotor_1_visual">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.0 0.7 0.9 0.7</ambient>
          <diffuse>0.0 0.7 0.9 0.7</diffuse>
        </material>
      </visual>
    </link>

    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <link name="rotor_2">
      <pose>-0.2 0.2 0.02 0 0 0</pose>
      <inertial>
        <mass>0.009</mass>
        <inertia>
          <ixx>1.75e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.75e-05</iyy>
          <iyz>0</iyz>
          <izz>3.5e-05</izz>
        </inertia>
      </inertial>
      <collision name="rotor_2_collision">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="rotor_2_visual">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.0 0.7 0.9 0.7</ambient>
          <diffuse>0.0 0.7 0.9 0.7</diffuse>
        </material>
      </visual>
    </link>

    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <link name="rotor_3">
      <pose>-0.2 -0.2 0.02 0 0 0</pose>
      <inertial>
        <mass>0.009</mass>
        <inertia>
          <ixx>1.75e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.75e-05</iyy>
          <iyz>0</iyz>
          <izz>3.5e-05</izz>
        </inertia>
      </inertial>
      <collision name="rotor_3_collision">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="rotor_3_visual">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.0 0.7 0.9 0.7</ambient>
          <diffuse>0.0 0.7 0.9 0.7</diffuse>
        </material>
      </visual>
    </link>

    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <!-- ======================================================= -->
    <!-- MULTICOPTER MOTOR MODEL PLUGINS (one per rotor)          -->
    <!-- These convert commanded rotor speed into actual thrust   -->
    <!-- and drag applied to each rotor link. Required for the    -->
    <!-- MulticopterVelocityControl plugin below to work: it only -->
    <!-- computes the target rotor speeds, it does not apply any  -->
    <!-- force by itself.                                         -->
    <!-- ======================================================= -->

    <plugin
      filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace></robotNamespace>
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>800.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <actuator_number>0</actuator_number>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <plugin
      filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace></robotNamespace>
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>800.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <actuator_number>1</actuator_number>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <plugin
      filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace></robotNamespace>
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>800.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <actuator_number>2</actuator_number>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <plugin
      filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace></robotNamespace>
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>800.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <actuator_number>3</actuator_number>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <!-- ======================================================= -->
    <!-- MULTICOPTER VELOCITY CONTROL PLUGIN (Flight Dynamics)    -->
    <!-- Subscribes to cmd_vel (Twist), computes the rotor speeds -->
    <!-- needed to achieve that body-frame velocity/yaw rate, and -->
    <!-- writes them for the 4 MulticopterMotorModel plugins above-->
    <!-- to actually turn into thrust. robotNamespace is left     -->
    <!-- empty on purpose: gz-sim then auto-scopes the topic to   -->
    <!-- /model/<spawned_name>/cmd_vel, which matches what the    -->
    <!-- ros_gz_bridge in entrypoint_drone.sh remaps to.          -->
    <!-- ======================================================= -->
    <plugin
      filename="libgz-sim-multicopter-control-system.so"
      name="gz::sim::systems::MulticopterVelocityControl">
      <robotNamespace>__ROBOT_NAMESPACE__</robotNamespace>
      <commandSubTopic>cmd_vel</commandSubTopic>
      <enableSubTopic>enable</enableSubTopic>
      <comLinkName>base_link</comLinkName>

      <velocityGain>3.3 3.3 3.5</velocityGain>
      <attitudeGain>5.0 5.0 0.9</attitudeGain>
      <angularRateGain>1.5 1.5 0.09</angularRateGain>

      <maximumLinearAcceleration>2 2 2</maximumLinearAcceleration>
      <maximumLinearVelocity>5 5 5</maximumLinearVelocity>
      <maximumAngularVelocity>3 3 3</maximumAngularVelocity>

      <linearVelocityNoiseMean>0 0 0</linearVelocityNoiseMean>
      <linearVelocityNoiseStdDev>0 0 0</linearVelocityNoiseStdDev>
      <angularVelocityNoiseMean>0 0 0</angularVelocityNoiseMean>
      <angularVelocityNoiseStdDev>0 0 0</angularVelocityNoiseStdDev>

      <rotorConfiguration>
        <rotor>
          <jointName>rotor_0_joint</jointName>
          <forceConstant>8.54858e-06</forceConstant>
          <momentConstant>0.016</momentConstant>
          <direction>1</direction>
        </rotor>
        <rotor>
          <jointName>rotor_1_joint</jointName>
          <forceConstant>8.54858e-06</forceConstant>
          <momentConstant>0.016</momentConstant>
          <direction>-1</direction>
        </rotor>
        <rotor>
          <jointName>rotor_2_joint</jointName>
          <forceConstant>8.54858e-06</forceConstant>
          <momentConstant>0.016</momentConstant>
          <direction>-1</direction>
        </rotor>
        <rotor>
          <jointName>rotor_3_joint</jointName>
          <forceConstant>8.54858e-06</forceConstant>
          <momentConstant>0.016</momentConstant>
          <direction>1</direction>
        </rotor>
      </rotorConfiguration>
    </plugin>

    <!-- ======================================================= -->
    <!-- ODOMETRY PUBLISHER PLUGIN                               -->
    <!-- Publishes ground truth position/odometry of base_link    -->
    <!-- ======================================================= -->
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
    </plugin>

  </model>
</sdf>